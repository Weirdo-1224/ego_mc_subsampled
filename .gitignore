# 大型二进制：原始视频（数据集文件，不入库；LFS 规则保留在 .gitattributes 备用）
videos/*.MP4
# 隔离的无标注视频
excluded/

# 缓存与环境
.cache/
__pycache__/
*.py[cod]

# 系统文件
Thumbs.db
Desktop.ini

# 可重生成的审查媒体产物（帧/剪辑/缩略图，由 ffmpeg 从原始视频导出）
results/video_review/**/clips/
results/video_review/**/frames/
results/video_review/**/detail/
results/video_review/**/sheets/
results/video_review/**/keyframe_images/

