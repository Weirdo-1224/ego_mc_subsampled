{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lhsp-agentbench:preparation:0.1.0",
  "title": "Streaming benchmark preparation bundle (provisional)",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode", "sources", "evidence", "records"],
  "properties": {
    "episode": {"$ref": "#/$defs/episode"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "time": {"type": "number", "minimum": 0},
    "nullable_time": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "interval": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}}
    },
    "refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "reviewer": {"type": ["string", "null"], "minLength": 1},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "kind", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["annotation", "video", "design", "manifest"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "episode": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "dataset", "video_source_id", "duration_seconds", "duration_method", "maturity", "review", "split", "provenance"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "id": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "video_source_id": {"type": "string", "minLength": 1},
        "duration_seconds": {"$ref": "#/$defs/nullable_time"},
        "duration_method": {"enum": ["ffprobe", "human", "unknown"]},
        "maturity": {"enum": ["CANDIDATE", "REVIEWED", "GOLD"]},
        "review": {"$ref": "#/$defs/review"},
        "split": {"const": "preparation"},
        "provenance": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "episode_id", "source_id", "interval", "available_at", "visibility", "source_pointer", "quote", "source_label", "maturity", "review"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "interval": {"$ref": "#/$defs/interval"},
        "available_at": {"$ref": "#/$defs/nullable_time"},
        "visibility": {"enum": ["TIMED_PUBLIC", "PRIVATE"]},
        "source_pointer": {"type": "string", "minLength": 1},
        "quote": {"type": ["string", "null"]},
        "source_label": {"type": "string", "minLength": 1},
        "maturity": {"enum": ["CANDIDATE", "REVIEWED", "GOLD"]},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "episode_id", "type", "interval", "known_at", "visibility", "maturity", "review", "evidence_refs", "derived_from", "provenance", "payload"],
      "properties": {
        "schema_version": {"const": "0.1.0"},
        "id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["Event", "State", "Dependency", "Rule", "Task", "Gold", "Intervention"]},
        "interval": {"$ref": "#/$defs/interval"},
        "known_at": {"$ref": "#/$defs/time"},
        "visibility": {"enum": ["PRIVATE", "TIMED_PUBLIC"]},
        "maturity": {"enum": ["CANDIDATE", "REVIEWED", "GOLD"]},
        "review": {"$ref": "#/$defs/review"},
        "evidence_refs": {"allOf": [{"$ref": "#/$defs/refs"}], "minItems": 1},
        "derived_from": {"$ref": "#/$defs/refs"},
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["method", "notes"],
          "properties": {"method": {"enum": ["source_copy", "text_candidate", "human"]}, "notes": {"type": "string", "minLength": 1}}
        },
        "payload": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "Event"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/Event"}}}},
        {"if": {"properties": {"type": {"const": "State"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/State"}}}},
        {"if": {"properties": {"type": {"const": "Dependency"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/Dependency"}}}},
        {"if": {"properties": {"type": {"const": "Rule"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/Rule"}}}},
        {"if": {"properties": {"type": {"const": "Task"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/Task"}}}},
        {"if": {"properties": {"type": {"const": "Gold"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/Gold"}}}},
        {"if": {"properties": {"type": {"const": "Intervention"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/Intervention"}}}}
      ]
    },
    "Event": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "text", "source_label"],
      "properties": {
        "kind": {"enum": ["annotation_utterance", "observed_action"]},
        "text": {"type": "string", "minLength": 1}, "source_label": {"type": "string", "minLength": 1}
      }
    },
    "State": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "property", "value", "basis"],
      "properties": {
        "subject": {"type": "string", "minLength": 1}, "property": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "basis": {"enum": ["unknown", "reported", "observed"]}
      }
    },
    "Dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["relation", "from_ref", "to_ref", "rationale"],
      "properties": {
        "relation": {"enum": ["candidate_precondition", "requires_state", "requires_step", "supersedes", "historical_context"]},
        "from_ref": {"type": "string"}, "to_ref": {"type": "string"}, "rationale": {"type": "string", "minLength": 1}
      }
    },
    "Rule": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "issued_at", "effective_from", "effective_to", "supersedes", "condition", "scope"],
      "properties": {
        "text": {"type": "string", "minLength": 1}, "issued_at": {"$ref": "#/$defs/time"},
        "effective_from": {"$ref": "#/$defs/nullable_time"}, "effective_to": {"$ref": "#/$defs/nullable_time"},
        "supersedes": {"$ref": "#/$defs/refs"}, "condition": {"type": ["string", "null"]},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "Task": {
      "type": "object", "additionalProperties": false,
      "required": ["track", "question", "query_time", "earliest_answerable_time", "required_evidence_sets", "target_refs", "answer_type", "history_necessity", "enabled"],
      "properties": {
        "track": {"enum": ["T1", "T2", "T3"]}, "question": {"type": "string", "minLength": 1},
        "query_time": {"$ref": "#/$defs/time"}, "earliest_answerable_time": {"$ref": "#/$defs/nullable_time"},
        "required_evidence_sets": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/refs"}], "minItems": 1}},
        "target_refs": {"allOf": [{"$ref": "#/$defs/refs"}], "minItems": 1},
        "answer_type": {"enum": ["state_or_unknown", "satisfied_unsatisfied_unknown", "text_or_unknown"]},
        "history_necessity": {"enum": ["PENDING", "CONFIRMED", "NOT_REQUIRED"]}, "enabled": {"type": "boolean"}
      }
    },
    "Gold": {
      "type": "object", "additionalProperties": false,
      "required": ["task_ref", "answer", "supporting_refs"],
      "properties": {
        "task_ref": {"type": "string"}, "answer": {"type": ["string", "number", "boolean", "object"]},
        "supporting_refs": {"allOf": [{"$ref": "#/$defs/refs"}], "minItems": 1}
      }
    },
    "Intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "feedback_event_ref", "feedback_given_at", "error_onset", "detectable_from", "deadline", "resolved_at"],
      "properties": {
        "kind": {"enum": ["feedback_anchor", "verified_incident"]}, "feedback_event_ref": {"type": "string"},
        "feedback_given_at": {"$ref": "#/$defs/time"}, "error_onset": {"$ref": "#/$defs/nullable_time"},
        "detectable_from": {"anyOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
        "deadline": {"$ref": "#/$defs/nullable_time"}, "resolved_at": {"$ref": "#/$defs/nullable_time"}
      }
    }
  }
}
