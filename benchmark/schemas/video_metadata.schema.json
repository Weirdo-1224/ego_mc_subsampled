{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ego-mc-bench.local/schemas/video_metadata.schema.json",
  "title": "VideoMetadata",
  "description": "Stage 1 artifact: standardized per-video metadata generated from the raw video file (ffprobe) and its annotation row.",
  "type": "object",
  "required": [
    "video_id",
    "path",
    "file_size_bytes",
    "container",
    "duration_seconds",
    "fps",
    "resolution",
    "video_codec",
    "has_annotation",
    "event_count",
    "type_counts",
    "timestamp_index",
    "schema_version"
  ],
  "additionalProperties": false,
  "properties": {
    "video_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "description": "Video file path relative to the dataset root."},
    "file_size_bytes": {"type": "integer", "minimum": 0},
    "container": {"type": "string"},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "exclusiveMinimum": 0},
        "height": {"type": "integer", "exclusiveMinimum": 0}
      }
    },
    "video_codec": {"type": "string"},
    "has_annotation": {
      "type": "boolean",
      "description": "Whether annotations/annotations.json contains a row for this video."
    },
    "event_count": {"type": "integer", "minimum": 0, "description": "Number of raw annotation events; 0 if unannotated."},
    "type_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "description": "Event count per text_type."
    },
    "timestamp_index": {
      "type": "object",
      "properties": {
        "Instruction": {"$ref": "#/$defs/timestampIndex"},
        "Feedback": {"$ref": "#/$defs/timestampIndex"},
        "Success": {"$ref": "#/$defs/timestampIndex"}
      },
      "additionalProperties": false,
      "description": "Timestamp lookup for the three core text types, keyed by event index in the raw annotation arrays."
    },
    "schema_version": {"type": "string", "const": "1.0.0"}
  },
  "$defs": {
    "timestampIndex": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "timestamp": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
